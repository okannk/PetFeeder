/*
 * config.h.example — Örnek yapılandırma dosyası
 * Bu dosyayı config.h olarak kopyala ve değerlerini düzenle.
 * config.h asla git'e commit edilmez (.gitignore ile korunur).
 *
 * WiFi SSID/şifresi burada değil — uygulama içi kurulum sihirbazı ile ayarlanır.
 */
#pragma once

// Backend sunucusu — wifi.json yoksa kullanılacak varsayılan
#define BACKEND_HOST_DEFAULT   "192.168.1.10"
#define BACKEND_PORT_DEFAULT   3001

// OTA (kablosuz firmware güncelleme) şifresi — kendi şifreni belirle
#define OTA_PASSWORD            "CHANGE_ME_OTA_PASSWORD"

// Kurulum AP'sinin şifresi — uygulamada kullanıcıya gösterilir
#define SETUP_AP_PASSWORD       "petfeeder123"
